# --- Storyhollow configuration -----------------------------------------------
# Copy this file to .env.local and fill in your keys.

# Claude writes the stories (and reads your book photos). https://console.anthropic.com
ANTHROPIC_API_KEY=

# ElevenLabs performs the voices, chimes in between are made by the app.
# https://elevenlabs.io/app/settings/api-keys  (Creator plan or higher recommended)
ELEVENLABS_API_KEY=

# A secret word needed to create a library card. Set it whenever the app is on
# the internet, so strangers can't sign up and spend your credits.
SIGNUP_CODE=

# Optional overrides
# STORY_MODEL=claude-opus-5-5
# VOICE_MODEL=eleven_v4
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Where books, photos and audio are stored (defaults to ./data)
# DATA_DIR=./data

# Automatic nightly backups to S3-compatible storage you own (Backblaze B2, Cloudflare R2, Amazon S3).
# Off unless the first four are set. See "Automatic backups" in the README.
# BACKUP_ENDPOINT=s3.us-west-004.backblazeb2.com
# BACKUP_BUCKET=
# BACKUP_KEY_ID=
# BACKUP_SECRET_KEY=
# BACKUP_REGION=

# Demo mode: no keys needed. Uses a pretend storyteller and humming "voices"
# so you can click through every screen. Never use for real stories.
# DEMO_MODE=1
